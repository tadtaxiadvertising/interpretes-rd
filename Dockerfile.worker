# Dedicated Intérpretes RD Roleplay audio worker.
# Build TypeScript once; the final image contains only production dependencies.
# GitHub Actions validates this same image; no production audio is used in CI.
FROM node:22-bookworm-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY package.json package-lock.json ./
# Avoid large audio/Prisma toolchain installs on undersized VPS builders.
COPY scripts/ci/assert-build-memory.mjs ./scripts/ci/assert-build-memory.mjs
RUN node scripts/ci/assert-build-memory.mjs
RUN npm_config_onnxruntime_node_install=skip npm ci --legacy-peer-deps

COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma.config.ts ./prisma.config.ts
RUN npx prisma generate --schema=prisma/schema.prisma

COPY tsconfig.json tsconfig.scripts.json ./
COPY src/lib/prisma.ts src/lib/database-pool-config.ts ./src/lib/
COPY src/lib/roleplay-limits.ts src/lib/roleplay-audio-conversion.ts ./src/lib/
COPY src/lib/roleplay-audio-worker-lease.ts src/lib/roleplay-audio-worker-config.ts ./src/lib/
COPY src/lib/roleplay-audio-worker-errors.ts ./src/lib/
COPY scripts/roleplay-audio-worker.ts ./scripts/roleplay-audio-worker.ts

# tsx depends on esbuild; only the builder uses either development tool.
# Bundle @/lib imports to avoid requiring the TS path alias or tsx in runtime.
# External node_modules preserve Prisma and ffmpeg-static's native binaries.
RUN node scripts/ci/assert-build-memory.mjs
RUN ./node_modules/.bin/esbuild scripts/roleplay-audio-worker.ts \
    --bundle --platform=node --format=esm --target=node22 --packages=external \
    --tsconfig=tsconfig.scripts.json --alias:@=./src \
    --outfile=dist/roleplay-audio-worker.mjs && \
    test -s dist/roleplay-audio-worker.mjs && \
    ! grep -Fq '@/lib/' dist/roleplay-audio-worker.mjs

FROM node:22-bookworm-slim AS runner
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Use npm's frozen production dependency graph, rather than copying all
# builder tools (Vitest, Vite, ESLint, tsx, etc.) into the live container.
COPY package.json package-lock.json ./
# Runner-stage npm installs are also memory-intensive on low-RAM servers.
# Always check this stage independently from the builder stage.
COPY scripts/ci/assert-build-memory.mjs ./scripts/ci/assert-build-memory.mjs
RUN node scripts/ci/assert-build-memory.mjs
RUN npm_config_onnxruntime_node_install=skip npm ci --omit=dev --legacy-peer-deps && \
    npm cache clean --force

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY prisma/schema.prisma ./prisma/schema.prisma
COPY certs/prod-ca-2021.crt ./certs/prod-ca-2021.crt

# A healthy build must include runnable native FFmpeg and generated Prisma;
# the worker's missing-env guard must fail safely before opening any DB.
RUN test ! -e node_modules/.bin/tsx && \
    test ! -e node_modules/.bin/vitest && \
    node -e "const p=require('ffmpeg-static'); if(!p)process.exit(1); require('node:child_process').execFileSync(p,['-version'],{stdio:'ignore'});" && \
    node -e "const cp=require('node:child_process');const r=cp.spawnSync(process.execPath,['dist/roleplay-audio-worker.mjs'],{env:{...process.env,DATABASE_URL:'',NEXT_PUBLIC_SUPABASE_URL:'',SUPABASE_SERVICE_ROLE_KEY:''},encoding:'utf8',timeout:15000});if(r.status!==1||!r.stderr.includes('Missing required environment variables:'))process.exit(1);"

ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=256"

RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 --gid nodejs --home-dir /app worker && \
    chown -R worker:nodejs /app
USER worker

CMD ["node", "dist/roleplay-audio-worker.mjs"]
