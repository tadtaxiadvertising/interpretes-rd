# Dedicated Roleplay audio worker. This image does not run Next.js.
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps && npm cache clean --force

COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma.config.ts ./prisma.config.ts
RUN npx prisma generate --schema=prisma/schema.prisma

# Verify the packaged FFmpeg executable runs in the actual worker image base.
RUN node --input-type=commonjs -e "const p = require('ffmpeg-static'); if (!p) process.exit(1); require('node:child_process').execFileSync(p, ['-version'], { stdio: 'ignore' });"

COPY tsconfig.json ./tsconfig.json
COPY certs/prod-ca-2021.crt ./certs/prod-ca-2021.crt
COPY src/lib/prisma.ts ./src/lib/prisma.ts
COPY src/lib/database-pool-config.ts ./src/lib/database-pool-config.ts
COPY src/lib/roleplay-audio-conversion.ts ./src/lib/roleplay-audio-conversion.ts
COPY scripts/roleplay-audio-worker.ts ./scripts/roleplay-audio-worker.ts

ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=256"

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 worker && \
    chown -R worker:nodejs /app

USER worker

CMD ["./node_modules/.bin/tsx", "scripts/roleplay-audio-worker.ts"]
