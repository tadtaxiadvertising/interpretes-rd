generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}



model Interpreter {
  id                          Int                      @id @default(autoincrement())
  externalId                  String                   @unique @map("external_id")
  name                        String
  status                      String?                  @default("Activo")
  realtimeStatus              String?                  @default("Offline") @map("realtime_status")
  statusReason                String?                  @default("initial") @map("status_reason")
  lastHeartbeat               DateTime?                @map("last_heartbeat") @db.Timestamptz(6)
  lastActivity                DateTime?                @map("last_activity") @db.Timestamptz(6)
  lastOnlineAt                DateTime?                @map("last_online_at") @db.Timestamptz(6)
  lastOfflineAt               DateTime?                @map("last_offline_at") @db.Timestamptz(6)
  statusChangedAt             DateTime?                @map("status_changed_at") @db.Timestamptz(6)
  browserTabId                String?                  @map("browser_tab_id")
  clientIp                    String?                  @map("client_ip")
  campaign                    String?
  languageA                   String?                  @default("Español") @map("language_a")
  languageB                   String?                  @default("Inglés") @map("language_b")
  emailCorporativo            String?                  @unique @map("email_corporativo")
  telefono                    String?
  pais                        String?
  metodoPago                  String?                  @default("Transferencia Bancaria") @map("metodo_pago")
  cuentaPago                  String?                  @map("cuenta_pago")
  documentosCompleto          Boolean?                 @default(false) @map("documentos_completo")
  notas                       String?
  tariffPerMinute             Decimal                  @map("tariff_per_minute") @db.Decimal(10, 2)
  createdAt                   DateTime?                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime?                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  banco                       String?
  tipoCuenta                  String?                  @map("tipo_cuenta")
  cedulaRnc                   String?                  @map("cedula_rnc")
  monthlyGoal                 Int                      @default(2000) @map("monthly_goal")
  paymentFrequency            String?                  @default("Monthly") @map("payment_frequency")
  paymentDay                  String?                  @default("1") @map("payment_day")
  shiftStart                  String?                  @default("09:00") @map("shift_start")
  shiftEnd                    String?                  @default("17:00") @map("shift_end")
  callSessions                CallSession[]
  accountRates                InterpreterAccountRate[]
  auditLogs                   PayrateAuditLog[]
  payrollRecords              PayrollRecord[]
  productionLogs              ProductionLog[]
  qaScores                    QAScore[]
  roleplaySessions            RoleplaySession[]
  userProfile                 UserProfile?
  statusLogs                  InterpreterStatusLog[]
  monthlyMetrics              InterpreterMonthlyMetrics[]
  hiredRecruitmentApplication RecruitmentApplication?  @relation("HiredInterpreter")

  @@index([createdAt], map: "idx_interpreters_created_at")
  @@index([pais], map: "idx_interpreters_pais")
  @@index([status], map: "idx_interpreters_status")
  @@map("interpreters")
  @@schema("public")
}

model InterpreterStatusLog {
  id              Int      @id @default(autoincrement())
  interpreterId   Int      @map("interpreter_id")
  previousStatus  String?  @map("previous_status")
  newStatus       String   @map("new_status")
  reason          String   @default("manual")
  changedBy       String?  @map("changed_by")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  interpreter     Interpreter @relation(fields: [interpreterId], references: [id], onDelete: Cascade)

  @@index([interpreterId, createdAt(sort: Desc)], map: "idx_status_logs_interpreter_time")
  @@index([createdAt], map: "idx_status_logs_created_at")
  @@map("interpreter_status_logs")
  @@schema("public")
}

model InterpreterMonthlyMetrics {
  id                 Int       @id @default(autoincrement())
  interpreterId      Int       @map("interpreter_id")
  period             String    @map("period") // YYYY-MM format
  interpretedMinutes Int       @default(0) @map("interpreted_minutes")
  qaScore            Decimal?  @db.Decimal(5, 2) @map("qa_score")
  rankingPosition    Int?      @map("ranking_position")
  totalInterpreters  Int?      @map("total_interpreters")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  interpreter        Interpreter @relation(fields: [interpreterId], references: [id], onDelete: Cascade)

  @@unique([interpreterId, period], map: "unique_interpreter_monthly_metrics")
  @@index([period], map: "idx_monthly_metrics_period")
  @@index([rankingPosition], map: "idx_monthly_metrics_ranking")
  @@map("interpreter_monthly_metrics")
  @@schema("public")
}

model Account {
  id               Int                      @id @default(autoincrement())
  name             String                   @unique
  description      String?
  createdAt        DateTime?                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime?                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  interpreterRates InterpreterAccountRate[]
  productionLogs   ProductionLog[]

  @@map("accounts")
  @@schema("public")
}

model InterpreterAccountRate {
  id            Int          @id @default(autoincrement())
  interpreterId Int?         @map("interpreter_id")
  accountId     Int?         @map("account_id")
  tariffPerHour Decimal      @map("tariff_per_hour") @db.Decimal(10, 2)
  createdAt     DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  interpreter   Interpreter? @relation(fields: [interpreterId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([interpreterId, accountId])
  @@map("interpreter_account_rates")
  @@schema("public")
}

model ProductionLog {
  id                 Int          @id @default(autoincrement())
  interpreterId      Int?         @map("interpreter_id")
  accountId          Int?         @map("account_id")
  date               DateTime     @db.Date
  campaign           String?
  scheduledHours     String?      @map("scheduled_hours")
  loginTime          DateTime?    @map("login_time") @db.Timestamptz(6)
  logoutTime         DateTime?    @map("logout_time") @db.Timestamptz(6)
  connectedHours     Decimal?     @map("connected_hours") @db.Decimal(10, 2)
  interpretedMinutes Int?         @default(0) @map("interpreted_minutes")
  callsAttended      Int?         @default(0) @map("calls_attended")
  adherence          Decimal?     @db.Decimal(5, 2)
  status             String
  observaciones      String?
  createdAt          DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  verifiedMinutes    Int?         @map("verified_minutes")
  isSettled          Boolean      @default(false) @map("is_settled")
  payrollRecordId    String?      @map("payroll_record_id")
  account            Account?     @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payrollRecord      PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  interpreter        Interpreter? @relation(fields: [interpreterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  qaScore            QAScore?

  @@index([date], map: "idx_production_logs_date")
  @@index([interpreterId, date], map: "idx_production_logs_interpreter_date")
  @@index([status], map: "idx_production_logs_status")
  @@unique([interpreterId, date], map: "unique_manual_log_per_day", where: { status: "Manual" })
  @@map("production_logs")
  @@schema("public")
}

model QAScore {
  id                  Int            @id @default(autoincrement())
  productionLogId     Int?           @unique @map("production_log_id")
  interpreterId       Int?           @map("interpreter_id")
  auditDate           DateTime       @map("audit_date") @db.Timestamptz(6)
  auditor             String?
  callDuration        Int?           @map("call_duration")
  callType            String?        @map("call_type")
  protocolScore       Decimal?       @map("protocol_score") @db.Decimal(5, 2)
  interpretationScore Decimal?       @map("interpretation_score") @db.Decimal(5, 2)
  languageScore       Decimal?       @map("language_score") @db.Decimal(5, 2)
  serviceScore        Decimal?       @map("service_score") @db.Decimal(5, 2)
  technicalScore      Decimal?       @map("technical_score") @db.Decimal(5, 2)
  totalScore          Decimal?       @map("total_score") @db.Decimal(5, 2)
  criticalError       Boolean?       @default(false) @map("critical_error")
  comentarios         String?
  accionRequerida     String?        @map("accion_requerida")
  createdAt           DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  interpreter         Interpreter?   @relation(fields: [interpreterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  productionLog       ProductionLog? @relation(fields: [productionLogId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roleplaySession     RoleplaySession?

  @@index([auditDate], map: "idx_qa_scores_audit_date")
  @@index([interpreterId], map: "idx_qa_scores_interpreter_id")
  @@map("qa_scores")
  @@schema("public")
}

model PayrollRecord {
  id                   String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  periodStart          DateTime     @map("period_start") @db.Date
  periodEnd            DateTime     @map("period_end") @db.Date
  interpreterId        Int?         @map("interpreter_id")
  totalMinutes         Int          @map("total_minutes")
  grossTotal           Decimal      @map("gross_total") @db.Decimal(10, 2)
  qualityBonus         Decimal?     @default(0) @map("quality_bonus") @db.Decimal(10, 2)
  penalidades          Decimal?     @default(0) @map("penalidades") @db.Decimal(10, 2)
  transferDeduction    Decimal?     @default(0) @map("transfer_deduction") @db.Decimal(10, 2)
  netTotal             Decimal      @map("net_total") @db.Decimal(10, 2)
  status               String?      @default("Pendiente")
  paymentDate          DateTime?    @map("payment_date") @db.Timestamptz(6)
  createdAt            DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  verifiedMinutes      Int?         @map("verified_minutes")
  incentivesTotal      Decimal      @default(0) @map("incentives_total") @db.Decimal(10, 2)
  paidAt               DateTime?    @map("paid_at") @db.Timestamptz(6)
  transactionReference String?      @map("transaction_reference")
  reconciliationHash   String?      @unique @map("reconciliation_hash")
  interpreter          Interpreter? @relation(fields: [interpreterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  productionLogs       ProductionLog[]
  callSessions         CallSession[]

  @@unique([interpreterId, periodStart, periodEnd], map: "unique_payroll_per_interpreter_period")
  @@index([interpreterId], map: "idx_payroll_records_interpreter")
  @@index([periodStart, periodEnd], map: "idx_payroll_records_period")
  @@index([status], map: "idx_payroll_records_status")
  @@map("payroll_records")
  @@schema("public")
}

model RecruitmentCandidate {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  telefono         String?
  pais             String?
  fuente           String?
  englishLevel     String?   @map("english_level")
  speedtestMbps    Int?      @map("speedtest_mbps")
  fechaPostulacion DateTime  @default(now()) @map("fecha_postulacion") @db.Timestamptz(6)
  fechaEntrevista  DateTime? @map("fecha_entrevista") @db.Timestamptz(6)
  resultRoleplay   Int?      @map("result_roleplay")
  fechaOferta      DateTime? @map("fecha_oferta") @db.Timestamptz(6)
  fechaInicio      DateTime? @map("fecha_inicio") @db.Timestamptz(6)
  responsable      String?
  notas            String?
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  roleplaySessions RoleplaySession[]
  applications     RecruitmentApplication[]

  @@index([fechaPostulacion], map: "idx_recruitment_candidates_fecha_postulacion")
  @@map("recruitment_candidates")
  @@schema("public")
}

enum RecruitmentApplicationStatus {
  APPLIED
  PROFILE_PENDING
  DOCUMENTS_PENDING
  LANGUAGE_PENDING
  TECHNICAL_PENDING
  INDUCTION_PENDING
  ROLEPLAY_PENDING
  ROLEPLAY_IN_PROGRESS
  ROLEPLAY_REVIEW
  INTERVIEW_PENDING
  INTERVIEW_SCHEDULED
  INTERVIEW_REVIEW
  OFFER_PENDING
  OFFER_SENT
  OFFER_ACCEPTED
  CONTRACT_PENDING
  BANKING_PENDING
  TECH_SETUP_PENDING
  TRAINING_PENDING
  READY_FOR_ACTIVATION
  HIRING
  HIRED
  REJECTED
  WITHDRAWN
  EXPIRED

  @@schema("public")
}

enum RecruitmentStep {
  APPLICATION
  PROFILE
  DOCUMENTS
  LANGUAGE
  TECHNICAL
  INDUCTION
  ROLEPLAY
  ROLEPLAY_REVIEW
  INTERVIEW
  DECISION
  OFFER
  CONTRACT
  BANKING
  TECH_SETUP
  TRAINING
  READY_FOR_ACTIVATION
  HIRING

  @@schema("public")
}

model RecruitmentApplication {
  id                    String                        @id @default(cuid())
  candidateId           Int                           @map("candidate_id")
  status                RecruitmentApplicationStatus  @default(APPLIED)
  currentStep           RecruitmentStep               @default(APPLICATION)
  version               Int                           @default(0)
  startedAt             DateTime                      @default(now()) @map("started_at") @db.Timestamptz(6)
  lastActivityAt        DateTime?                     @map("last_activity_at") @db.Timestamptz(6)
  completedAt           DateTime?                     @map("completed_at") @db.Timestamptz(6)
  hiredInterpreterId    Int?                          @unique @map("hired_interpreter_id")
  rejectionReason       String?                       @map("rejection_reason")
  withdrawalReason      String?                       @map("withdrawal_reason")
  lastActorId           String?                       @map("last_actor_id")
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidate             RecruitmentCandidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  access                RecruitmentAccess?
  events                RecruitmentEvent[]
  documents             RecruitmentDocument[]
  interviews            RecruitmentInterview[]
  offers                RecruitmentOffer[]
  contracts             RecruitmentContract[]
  banking               RecruitmentBanking?
  techSetup             RecruitmentTechSetup?
  training              RecruitmentTraining?
  hiredInterpreter      Interpreter?                  @relation("HiredInterpreter", fields: [hiredInterpreterId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([candidateId], map: "recruitment_application_candidate_id_key")
  @@index([status, currentStep], map: "idx_recruitment_application_status_step")
  @@index([lastActivityAt], map: "idx_recruitment_application_last_activity")
  @@index([createdAt], map: "idx_recruitment_application_created_at")
  @@map("recruitment_applications")
  @@schema("public")
}

model RecruitmentAccess {
  id            String   @id @default(cuid())
  applicationId String   @map("application_id")
  tokenHash     String   @unique @map("token_hash")
  inviteCode    String?  @unique @map("invite_code")
  expiresAt     DateTime @map("expires_at")
  lastUsedAt    DateTime? @map("last_used_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime @default(now()) @map("created_at")

  application   RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId], map: "recruitment_access_application_id_key")
  @@index([tokenHash], map: "idx_recruitment_access_token_hash")
  @@index([inviteCode], map: "idx_recruitment_access_invite_code")
  @@index([expiresAt], map: "idx_recruitment_access_expires")
  @@map("recruitment_access")
  @@schema("public")
}

enum RecruitmentEventType {
  APPLICATION_CREATED
  PROFILE_COMPLETED
  DOCUMENT_UPLOADED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  LANGUAGE_APPROVED
  LANGUAGE_REJECTED
  TECHNICAL_COMPLETED
  TECHNICAL_REJECTED
  INDUCTION_COMPLETED
  ROLEPLAY_CREATED
  ROLEPLAY_STARTED
  ROLEPLAY_SUBMITTED
  ROLEPLAY_EVALUATED
  ROLEPLAY_PASSED
  ROLEPLAY_FAILED
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  INTERVIEW_FAILED
  OFFER_SENT
  OFFER_ACCEPTED
  OFFER_REJECTED
  CONTRACT_SIGNED
  BANKING_COMPLETED
  TECH_SETUP_COMPLETED
  TRAINING_COMPLETED
  READY_FOR_ACTIVATION
  HIRING_STARTED
  HIRED
  REJECTED
  WITHDRAWN

  @@schema("public")
}

model RecruitmentEvent {
  id            String               @id @default(cuid())
  applicationId String               @map("application_id")
  eventType     RecruitmentEventType @map("event_type")
  fromStatus    RecruitmentApplicationStatus? @map("from_status")
  toStatus      RecruitmentApplicationStatus  @map("to_status")
  actorType     String               @map("actor_type") // 'candidate', 'admin', 'system'
  actorId       String               @map("actor_id")
  metadata      Json?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  application   RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt(sort: Desc)], map: "idx_recruitment_event_application_time")
  @@index([eventType], map: "idx_recruitment_event_type")
  @@index([actorId], map: "idx_recruitment_event_actor")
  @@map("recruitment_events")
  @@schema("public")
}

enum RecruitmentDocumentType {
  CV
  IDENTITY
  LANGUAGE_CERTIFICATE
  BACKGROUND_CHECK
  PHOTO
  CONTRACT
  OTHER

  @@schema("public")
}

enum RecruitmentDocumentStatus {
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED

  @@schema("public")
}

model RecruitmentDocument {
  id                String                    @id @default(cuid())
  applicationId     String                    @map("application_id")
  type              RecruitmentDocumentType
  storagePath       String                    @map("storage_path")
  mimeType          String                    @map("mime_type")
  size              Int
  status            RecruitmentDocumentStatus @default(UPLOADED)
  reviewedAt        DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy        String?                   @map("reviewed_by")
  rejectionReason   String?                   @map("rejection_reason")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  application       RecruitmentApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, type], map: "idx_recruitment_document_application_type")
  @@index([applicationId, status], map: "idx_recruitment_document_application_status")
  @@map("recruitment_documents")
  @@schema("public")
}

enum RecruitmentInterviewStatus {
  PENDING
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED

  @@schema("public")
}

model RecruitmentInterview {
  id              String                      @id @default(cuid())
  applicationId   String                      @map("application_id")
  scheduledAt     DateTime?                   @map("scheduled_at") @db.Timestamptz(6)
  status          RecruitmentInterviewStatus  @default(PENDING)
  meetingUrl      String?                     @map("meeting_url")
  notes           String?
  completedAt     DateTime?                   @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  application     RecruitmentApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, status], map: "idx_recruitment_interview_application_status")
  @@index([scheduledAt], map: "idx_recruitment_interview_scheduled_at")
  @@map("recruitment_interviews")
  @@schema("public")
}

enum RecruitmentOfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED

  @@schema("public")
}

model RecruitmentOffer {
  id              String                   @id @default(cuid())
  applicationId   String                   @map("application_id")
  status          RecruitmentOfferStatus   @default(DRAFT)
  sentAt          DateTime?                @map("sent_at") @db.Timestamptz(6)
  acceptedAt      DateTime?                @map("accepted_at") @db.Timestamptz(6)
  rejectedAt      DateTime?                @map("rejected_at") @db.Timestamptz(6)
  expiresAt       DateTime?                @map("expires_at") @db.Timestamptz(6)
  termsVersion    String?                  @map("terms_version")
  documentPath    String?                  @map("document_path")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  application     RecruitmentApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, status], map: "idx_recruitment_offer_application_status")
  @@map("recruitment_offers")
  @@schema("public")
}

enum RecruitmentContractStatus {
  PENDING
  SENT
  SIGNED
  REJECTED
  EXPIRED

  @@schema("public")
}

model RecruitmentContract {
  id              String                       @id @default(cuid())
  applicationId   String                       @map("application_id")
  status          RecruitmentContractStatus    @default(PENDING)
  documentPath    String?                      @map("document_path")
  signedAt        DateTime?                    @map("signed_at") @db.Timestamptz(6)
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  application     RecruitmentApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId], map: "recruitment_contract_application_id_key")
  @@map("recruitment_contracts")
  @@schema("public")
}

model RecruitmentBanking {
  id                String       @id @default(cuid())
  applicationId     String       @unique @map("application_id")
  bankName          String       @map("bank_name")
  bankAccount       String       @map("bank_account")
  bankAccountType   String       @map("bank_account_type")
  bankCedula        String       @map("bank_cedula")
  verifiedAt        DateTime?    @map("verified_at") @db.Timestamptz(6)
  verifiedBy        String?      @map("verified_by")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  application       RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("recruitment_banking")
  @@schema("public")
}

model RecruitmentTechSetup {
  id                String   @id @default(cuid())
  applicationId     String   @unique @map("application_id")
  hardware          Json?
  connectionType    String?  @map("connection_type")
  ping              Int?
  download          Int?
  upload            Int?
  jitter            Int?
  packetLoss        Float?   @map("packet_loss")
  headset           Boolean?
  microphone        Boolean?
  browser           String?
  softphone         String?
  mockCallCompleted Boolean?  @default(false) @map("mock_call_completed")
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  completedBy       String?   @map("completed_by")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  application       RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("recruitment_tech_setups")
  @@schema("public")
}

model RecruitmentTraining {
  id                String   @id @default(cuid())
  applicationId     String   @unique @map("application_id")
  blocksCompleted   Json?    @map("blocks_completed")
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  completedBy       String?   @map("completed_by")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  application       RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("recruitment_trainings")
  @@schema("public")
}

model SystemConfig {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  value       String
  description String?
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by")

  @@map("system_configs")
  @@schema("public")
}

model PayrateAuditLog {
  id            Int          @id @default(autoincrement())
  interpreterId Int?         @map("interpreter_id")
  oldRate       Decimal?     @map("old_rate") @db.Decimal(10, 2)
  newRate       Decimal      @map("new_rate") @db.Decimal(10, 2)
  changedBy     String       @map("changed_by")
  changedAt     DateTime?    @default(now()) @map("changed_at") @db.Timestamptz(6)
  details       String?
  interpreter   Interpreter? @relation(fields: [interpreterId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("payrate_audit_log")
  @@schema("public")
}

model Notification {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String?   @map("user_id") @db.Uuid
  title     String
  message   String
  type      String?   @default("info")
  category  String?   @default("system")
  isRead    Boolean?  @default(false) @map("is_read")
  link      String?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([isRead], map: "idx_notifications_is_read")
  @@index([userId], map: "idx_notifications_user_id")
  @@index([category], map: "idx_notifications_category")
  @@index([createdAt], map: "idx_notifications_created_at")
  @@map("notifications")
  @@schema("public")
}

model Message {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  senderId   String    @map("sender_id") @db.Uuid
  receiverId String    @map("receiver_id") @db.Uuid
  content    String
  isRead     Boolean?  @default(false) @map("is_read")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@map("messages")
  @@schema("public")
}

model UserProfile {
  id                 String       @id @db.Uuid
  email              String       @unique
  displayName        String?      @map("display_name")
  role               String?      @default("interpreter")
  interpreterId      Int?         @unique @map("interpreter_id")
  createdAt          DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  termsAcceptedAt    DateTime?    @map("terms_accepted_at") @db.Timestamptz(6)
  signatureDate      DateTime?    @map("signature_date") @db.Timestamptz(6)
  bankName           String?      @map("bank_name")
  bankAccount        String?      @map("bank_account")
  bankCedula         String?      @map("bank_cedula")
  onboardingComplete Boolean      @default(false) @map("onboarding_complete")
  bankAccountType    String?      @map("bank_account_type")
  interpreter        Interpreter? @relation(fields: [interpreterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([onboardingComplete], map: "idx_user_profiles_onboarding", where: raw("(onboarding_complete = false)"))
  @@map("user_profiles")
  @@schema("public")
}

model CallSession {
  id              Int          @id @default(autoincrement())
  interpreterId   Int?         @map("interpreter_id")
  startedAt       DateTime?    @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?    @map("ended_at") @db.Timestamptz(6)
  durationSeconds Int?         @map("duration_seconds")
  tariffSnapshot  Decimal      @map("tariff_snapshot") @db.Decimal(10, 2)
  callCost        Decimal?     @map("call_cost") @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  isSettled       Boolean      @default(false) @map("is_settled")
  payrollRecordId String?      @map("payroll_record_id")
  interpreter     Interpreter? @relation(fields: [interpreterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  payrollRecord   PayrollRecord? @relation(fields: [payrollRecordId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([interpreterId], map: "idx_call_sessions_interpreter_id")
  @@index([startedAt], map: "idx_call_sessions_started_at")
  @@unique([interpreterId], map: "unique_active_call", where: { endedAt: null })
  @@map("call_sessions")
  @@schema("public")
}

model RbacUser {
  id               String         @id @default(cuid())
  email            String         @unique
  password         String
  name             String
  role             RbacRole       @default(INTERPRETER)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  ownedAccounts    VaultAccount[] @relation("HolderVaultAccounts")
  assignedAccounts VaultAccount[] @relation("InterpreterAssigned")
  sentMessages     VaultMessage[] @relation("MessageAuthor")
  receivedMessages VaultMessage[] @relation("MessageRecipient")

  @@index([role])
  @@map("rbac_users")
  @@schema("public")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
  @@schema("public")
}



model VaultAccount {
  id            String            @id @default(cuid())
  platformName  String
  url           String?
  vpnConfig     String?
  credentials   String
  notes         String?
  holderId      String
  interpreterId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  holder        RbacUser          @relation("HolderVaultAccounts", fields: [holderId], references: [id], onDelete: Cascade)
  interpreter   RbacUser?         @relation("InterpreterAssigned", fields: [interpreterId], references: [id])
  attachments   VaultAttachment[]

  @@index([holderId])
  @@index([interpreterId])
  @@map("vault_accounts")
  @@schema("public")
}

model VaultAttachment {
  id         String       @id @default(cuid())
  fileName   String
  fileUrl    String
  fileSize   Int          @default(0)
  mimeType   String       @default("application/octet-stream")
  accountId  String
  uploadedAt DateTime     @default(now())
  account    VaultAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("vault_attachments")
  @@schema("public")
}

model VaultMessage {
  id          String             @id @default(cuid())
  content     String
  status      VaultMessageStatus @default(PENDING_ADMIN)
  authorId    String
  recipientId String?
  createdAt   DateTime           @default(now())
  author      RbacUser           @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  recipient   RbacUser?          @relation("MessageRecipient", fields: [recipientId], references: [id])

  @@index([authorId])
  @@index([recipientId])
  @@index([status])
  @@map("vault_messages")
  @@schema("public")
}

enum RbacRole {
  ADMIN
  HOLDER
  INTERPRETER

  @@schema("public")
}

enum VaultMessageStatus {
  PENDING_ADMIN
  APPROVED
  REJECTED

  @@schema("public")
}

model RoleplaySession {
  id                      String    @id @default(cuid())
  interpreterId           Int?      @map("interpreter_id")
  recruitmentCandidateId  Int?      @map("recruitment_candidate_id")
  baseAudioUrl            String    @map("base_audio_url")
  recordedAudioUrl        String?   @map("recorded_audio_url")
  status                  RoleplayStatus @default(DRAFT)
  evaluatorId             String?   @map("evaluator_id")
  qaScoreId               Int?      @unique @map("qa_score_id")
  submittedAt             DateTime? @map("submitted_at")
  evaluatedAt             DateTime? @map("evaluated_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  completedAt             DateTime? @map("completed_at")
  currentScenarioIndex    Int       @default(0) @map("current_scenario_index")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  reviewStartedAt         DateTime? @map("review_started_at")
  reviewPriority          Int?      @default(0) @map("review_priority")

  interpreter             Interpreter?         @relation(fields: [interpreterId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  recruitmentCandidate    RecruitmentCandidate? @relation(fields: [recruitmentCandidateId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  qaScore                 QAScore?             @relation(fields: [qaScoreId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  access                  RoleplayAccess?
  scenarios               RoleplayScenario[]

  @@index([interpreterId, status], map: "idx_roleplay_interpreter_status")
  @@index([recruitmentCandidateId, status], map: "idx_roleplay_candidate_status")
  @@index([status, createdAt], map: "idx_roleplay_status_created")
  @@index([status, submittedAt], map: "idx_roleplay_status_submitted")
  @@index([reviewPriority], map: "idx_roleplay_review_priority")
  @@map("roleplay_sessions")
  @@schema("public")
}

model RoleplayAccess {
  id            String   @id @default(cuid())
  sessionId     String   @map("session_id")
  tokenHash     String   @unique @map("token_hash")
  inviteCode    String?  @unique @map("invite_code")
  expiresAt     DateTime @map("expires_at")
  usedAt        DateTime? @map("used_at")
  validatedAt   DateTime? @map("validated_at")
  startedAt     DateTime? @map("started_at")
  createdAt     DateTime @default(now()) @map("created_at")

  session       RoleplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId], map: "roleplay_access_session_id_key")
  @@index([tokenHash], map: "idx_roleplay_access_token_hash")
  @@index([inviteCode], map: "idx_roleplay_access_invite_code")
  @@index([expiresAt], map: "idx_roleplay_access_expires")
  @@map("roleplay_access")
  @@schema("public")
}


model RoleplayScenario {
  id                String   @id @default(cuid())
  sessionId         String   @map("session_id")
  order             Int
  title             String
  baseAudioUrl      String   @map("base_audio_url")
  durationLimitSec  Int?     @map("duration_limit_sec")
  scriptPrompt      String?  @map("script_prompt")
  expectedKeys      String[] @map("expected_keys")
  createdAt         DateTime @default(now()) @map("created_at")

  session           RoleplaySession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  responses         RoleplayResponse[]

  @@index([sessionId, order])
  @@map("roleplay_scenarios")
  @@schema("public")
}

model RoleplayResponse {
  id                 String         @id @default(cuid())
  scenarioId         String         @map("scenario_id")
  sourceAudioUrl     String?        @map("source_audio_url")
  sourceAudioPath    String?        @map("source_audio_path")
  processedAudioUrl  String?        @map("processed_audio_url")
  processedAudioPath String?        @map("processed_audio_path")
  audioStatus        AudioStatus    @default(UPLOADED) @map("audio_status")
  processingError    String?        @map("processing_error")
  durationSec        Int?           @map("duration_sec")
  selfScore          Json?
  selfNotes          String?        @map("self_notes")
  submittedAt        DateTime?      @map("submitted_at")
  createdAt          DateTime       @default(now()) @map("created_at")

  scenario           RoleplayScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId], map: "roleplay_responses_scenario_id_key")
  @@map("roleplay_responses")
  @@schema("public")
}

enum AudioStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED

  @@schema("public")
}

enum RoleplayStatus {
  DRAFT
  INVITED
  STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  EVALUATED
  PASSED
  FAILED
  EXPIRED
  CANCELLED

  @@schema("public")
}


// Published agreement content is immutable by application policy. Drafts may be edited;
// publishing snapshots the exact text and its SHA-256 digest.
model LegalAgreementVersion {
  id          String   @id @default(cuid())
  agreementKey String  @map("agreement_key")
  version     String
  title       String
  content     String
  contentHash String   @map("content_hash")
  status      String   @default("DRAFT")
  createdBy   String?  @map("created_by")
  publishedBy String?  @map("published_by")
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  acceptances LegalAgreementAcceptance[]

  @@unique([agreementKey, version], map: "legal_agreement_versions_key_version_key")
  @@index([agreementKey, status, publishedAt], map: "idx_legal_agreement_versions_published")
  @@map("legal_agreement_versions")
  @@schema("public")
}

model LegalAgreementAcceptance {
  id                String   @id @default(cuid())
  agreementVersionId String  @map("agreement_version_id")
  userId            String?  @map("user_id") @db.Uuid
  interpreterId     Int?     @map("interpreter_id")
  signerEmail       String   @map("signer_email")
  contentHash       String   @map("content_hash")
  acceptedAt        DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  source            String   @default("onboarding")
  userAgent         String?  @map("user_agent")
  agreementVersion  LegalAgreementVersion @relation(fields: [agreementVersionId], references: [id], onDelete: Restrict)

  @@index([agreementVersionId, acceptedAt], map: "idx_legal_acceptances_version_date")
  @@index([userId, acceptedAt], map: "idx_legal_acceptances_user_date")
  @@index([interpreterId, acceptedAt], map: "idx_legal_acceptances_interpreter_date")
  @@map("legal_agreement_acceptances")
  @@schema("public")
}
