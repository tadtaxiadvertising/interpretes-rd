# ─────────────────────────────────────────────────────────────────────────────
# INTÉRPRETES RD — CONFIGURACIÓN DEL ENTORNO
# Target: Easypanel (Docker/VPS) + Supabase
# ─────────────────────────────────────────────────────────────────────────────
# ⚠ IMPORTANT: Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────────────────────────

# --- FRONTEND (interpreters) ---
# Required for client-side Supabase and API communication
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
NEXT_PUBLIC_API_URL="https://database-interpreters.rewvid.easypanel.host"

# --- BACKEND (interpreters-api) ---
# Required for Prisma and CORS security
DATABASE_URL="postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:5432/postgres"

# CORS: Dominio exacto del Frontend (sin trailing slash)
# Usado por next.config.ts y middleware.ts para restringir acceso cross-origin
FRONTEND_ORIGIN="https://interpretes.rd.ibusiness.com.do"

# --- AUTH & SECURITY ---
AUTH_SECRET="generate-a-random-32-char-string"
ENCRYPTION_KEY="generate-a-random-64-hex-string"

# --- AUDIO STUDIO / HAPPYSCRIBE (interpreters Next.js runtime ONLY) ---
# Separate from ENCRYPTION_KEY and from the HappyScribe API token.
# Exactly 64 hexadecimal characters (32 random bytes); never NEXT_PUBLIC_.
# Restore the ORIGINAL key if a token was previously encrypted in system_configs.
# Set only in the Next.js service's Easypanel runtime environment, not build args.
# Empty until provisioned securely; do not check actual secrets into Git.
AUDIO_STUDIO_ENCRYPTION_KEY=""

# Optional server-side fallback when no panel-encrypted token exists.
# Prefer managing the HappyScribe API token through Audio Studio admin settings.
# Do not paste AUDIO_STUDIO_ENCRYPTION_KEY into this API token field.
HAPPY_SCRIBE_API_TOKEN=""
HAPPY_SCRIBE_ORGANIZATION_ID=""

# MP3 transfer through the Next.js VPS is OFF by default; SRT import does
# not require enabling it.
HAPPY_SCRIBE_MEDIA_PROXY_ENABLED="false"

# ⚠️ RUNTIME-ONLY — Supabase Admin (service_role) key.
# Required for admin operations: user creation, email confirmation, password
# reset, user deletion. Set this in your Easypanel / VPS runtime environment.
#
# DO NOT pass this as a Docker build arg or bake it into the image.
# The application degrades gracefully without it: admin-only operations
# return a safe error response, but the server stays healthy.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- SHARED ---
NODE_ENV="production"

